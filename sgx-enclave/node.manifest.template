# =================================================================
# Gramine Manifest: SGX Enclave (Wallet Business Logic + SQLite + WSS Sync)
#
# Single enclave running Node.js with:
#   - SQLite in-process database (better-sqlite3)
#   - WSS RA-TLS peer-to-peer data synchronization
#   - SGX-enclave wallet business logic (Express HTTP API)
#
# Each node is both WSS RA-TLS server and client.
# Nodes synchronize via HLC-based conflict resolution (LWW + tombstones).
#
# Build:   docker build -f sgx-enclave/Dockerfile -t sgx-enclave .
# Run SGX: docker run --device /dev/sgx_enclave --device /dev/sgx_provision \
#            -v /var/run/aesmd:/var/run/aesmd sgx-enclave
# Run SIM: docker run -e SGX_MODE=direct sgx-enclave
# =================================================================

# Node.js is the direct entrypoint — RA-TLS cert generation is done in Node.js
libos.entrypoint = "/usr/local/bin/node"

# Working directory: sgx-enclave (relative paths resolve from here)
fs.start_dir = "/app/sgx-enclave"

loader.log_level = "{{ log_level }}"


# Disable host environment and command-line inheritance
# All env vars come from loader.env (passthrough or fixed)
loader.insecure__use_host_env = false
loader.insecure__use_cmdline_argv = false

loader.argv = [
  "node",
  "/app/sgx-enclave/gramine-launcher.js",
]

# --- Environment Variables ---
loader.env.LD_LIBRARY_PATH = "/usr/lib/x86_64-linux-gnu:/usr/local/lib:/lib"
loader.env.PATH = "/usr/local/bin:/usr/bin:/bin"
loader.env.HOME = "/app/sgx-enclave"
loader.env.NODE_ENV = "production"
loader.env.LANG = "C.UTF-8"
loader.env.LC_ALL = "C.UTF-8"
# Reduce per-thread stack from default 8MB to 1MB
sys.stack.size = "1M"
loader.env.NODE_OPTIONS = "--max-old-space-size=256"
loader.env.NODE_PATH = "/app/sgx-enclave/node_modules"

# RA-TLS certificate path (generated by Node.js at enclave startup)
# cert: allowed file (public); key: kept in memory only (never written to disk)
loader.env.RATLS_CERT_PATH = { passthrough = true }

# --- Passthrough env vars (from docker run -e) ---
# Only the variables listed below are accepted from the host environment.
# All other configuration MUST be read from the smart contract — there is
# no env-side fallback. The .env file is NOT loaded inside the enclave
# (no dotenv import, not in allowed_files), so writing keys to .env will
# NOT make them visible to process.env.

# SGX-enclave HTTP server (local listen port — deployment-specific)
loader.env.SGX_HTTP_PORT = { passthrough = true }

# SQLite database path — hardcoded in constants.js, not configurable
# Path: /app/sgx-enclave/wallet/sgx_wallet.db (encrypted partition, key = MRENCLAVE)

# --- WSS sync configuration (deployment topology — must stay local) ---
# SYNC_NODES: comma-separated WSS addresses of peer nodes
# Different deployments share the same contract but have different peer lists.
loader.env.SYNC_NODES = { passthrough = true }
# SYNC_LISTEN_PORT: WSS sync server listening port (default 3307)
loader.env.SYNC_LISTEN_PORT = { passthrough = true }
# NODE_ID: stable per-instance identifier. MUST be unique per node — cannot
# come from contract (contract config is shared). When unset, a fresh random
# UUID is generated on each process start; full-resync on the sender side
# cannot be resumed across restarts in that mode.
loader.env.NODE_ID = { passthrough = true }

# --- Smart contract bootstrap (cannot come from contract — chicken/egg) ---
loader.env.CONTRACT_RPC_URL = { passthrough = true }
loader.env.CONTRACT_CHAIN_ID = { passthrough = true }
loader.env.CONTRACT_ADDRESS = { passthrough = true }

# --- Runtime configuration: read EXCLUSIVELY from contract ---
# runtimeParams (incl. session/cache/reconnect/attestation/sync/security),
# platformWhitelist, enclaveWhitelist, codeRepository — all from contract.
# No env passthrough (previously RUNTIME_PARAMS / PLATFORM_WHITELIST /
# ENCLAVE_WHITELIST / CODE_REPOSITORY / FREEZE_DURATION_SECONDS / NUM_SHARDS
# / MIN_QUORUM are removed).

# --- PCCS API key: sensitive, never on-chain ---
loader.env.PROXY_API_KEY = { passthrough = true }

# --- Filesystem Mounts ---
# IMPORTANT: Parent mounts must come BEFORE child mounts.
# Gramine resolves mount points via path lookup; child mounts attach to
# the parent's dentry tree, so the parent chroot must be mounted first.
fs.mounts = [
  # Gramine runtime libraries (glibc)
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },

  # System libraries (real paths, not symlinks)
  { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
  { path = "/usr/local/lib", uri = "file:/usr/local/lib" },

  # Executables
  { path = "/usr/local/bin", uri = "file:/usr/local/bin" },
  { path = "/usr/bin", uri = "file:/usr/bin" },
  { path = "/bin", uri = "file:/usr/bin" },

  # System configuration
  { path = "/etc", uri = "file:/etc" },

  # --- Parent mounts BEFORE children (Gramine attaches child mounts to parent's dentry tree) ---

  # Application directories (parent chroot mounts first)
  { path = "/app/sgx-enclave", uri = "file:/app/sgx-enclave" },

  # Wallet encrypted storage (private keys, sensitive data, SQLite database)
  # key derived from MRENCLAVE — only accessible by exact same enclave code
  # MUST come AFTER /app/sgx-enclave mount so encrypted mount attaches to chroot's dentry tree
  { type = "encrypted", path = "/app/sgx-enclave/wallet", uri = "file:/app/sgx-enclave/wallet", key_name = "_sgx_mrenclave" },

  # Temporary directory (in-memory)
  { type = "tmpfs", path = "/tmp" },
]

# --- SGX Configuration ---
sgx.debug = false
sgx.enclave_size = "1024G"
sgx.max_threads = 32
sgx.edmm_enable = true
# Node.js V8 engine uses intentional page faults (e.g., for sandbox, GC traps).
# Without use_exinfo, Gramine cannot distinguish legitimate #PF from malicious
# host signals and terminates with "Host injected malicious signal 2".
sgx.use_exinfo = true
sgx.remote_attestation = "dcap"

# --- Trusted Files (signed, integrity-checked) ---
sgx.trusted_files = [
  # Gramine runtime
  "file:{{ gramine.libos }}",
  "file:{{ gramine.runtimedir() }}/",

  # Node.js binary
  "file:/usr/local/bin/node",

  # SGX-enclave application code
  "file:/app/sgx-enclave/gramine-launcher.js",
  "file:/app/sgx-enclave/index.js",
  "file:/app/sgx-enclave/src/",
  "file:/app/sgx-enclave/config/",
  "file:/app/sgx-enclave/package.json",

  # SGX-enclave Node.js modules (includes @xnetx/sgx-ra-tls-verify, better-sqlite3, ethers, ws, etc.)
  "file:/app/sgx-enclave/node_modules/",

  # System libraries (injected by build script — ldd discovery)
  # __TRUSTED_LIBS_PLACEHOLDER__

  # System configuration files
  "file:/etc/ld.so.cache",
  "file:/etc/localtime",
  "file:/etc/passwd",
  "file:/etc/group",
  "file:/etc/ssl/openssl.cnf",
  "file:/etc/ssl/certs/ca-certificates.crt",
]

# --- Allowed Files (mutable at runtime, not integrity-checked) ---
sgx.allowed_files = [
  # RA-TLS certificate (public, written by Node.js cert generator at startup)
  "file:/app/sgx-enclave/ratls-cert.pem",

  # NOTE: wallet/ directory is NOT in allowed_files.
  # It uses encrypted mount (see fs.mounts above) and files are written
  # by Node.js inside the enclave — no allowed_files entry needed.
  # Private key is kept in memory only (never written to disk).

  # System files that may change at runtime
  "file:/etc/hosts",
  "file:/etc/resolv.conf",
  "file:/etc/nsswitch.conf",
  "file:/etc/host.conf",
  "file:/etc/gai.conf",

  # NOTE: /app/sgx-enclave/.env is intentionally NOT in allowed_files.
  # All env vars must come via docker -e and are filtered by the
  # manifest passthrough whitelist above. dotenv loading is disabled
  # in JS code, so .env on disk has no effect.

  # Temporary files
  "file:/tmp/",
]

# Single enclave: Node.js only (no child processes).
# SQLite runs in-process, WSS sync is built-in.
# No trusted_children needed.
